# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Worktrees git créés par l'outillage : une copie complète du dépôt.
# Les suivre ferait un dépôt imbriqué, et doublerait tout parcours de src/.
.claude/worktrees/

# Identifiants des tests E2E — jamais versionnés
.env.test.local
e2e/.session.json

# Preuves Playwright : vidéos et traces, régénérées à chaque exécution
docs/beta-readiness/evidence/traces/
docs/beta-readiness/evidence/playwright-report/
docs/beta-readiness/evidence/resultats.json
